# user and group id for local dev
UID=1000
GID=1000

# url settings
REWRITE_BASE=
WEB_URL=

# database connection
DB_HOST={{DB_HOST}}
DB_DATABASE={{DB_NAME}}
DB_ROOT_PASSWORD=
DB_USERNAME={{DB_USER}}
DB_PASSWORD={{DB_PASS}}

# development settings
DEV_MODE=false

# settings encryption key (base64, 32 bytes) - für "secret"-Settings wie mail.password
# generieren mit: php -r "echo base64_encode(sodium_crypto_secretbox_keygen());"
SETTINGS_ENCRYPTION_KEY=

# shop api keys
SHOPURL=
SHOPKEY=

# openai chatgpt
OPENAI_API_KEY=

# google search console api keys
GOOGLE_SEARCHCONSOLE='.config/apiKeys/googleSearchConsoleAPIKey.json'
